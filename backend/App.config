<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <log4net debug="true">
    <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="TextilePOS.log" />
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <immediateFlush value="true" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%-5p %d %5rms %-22.22c{1} %-18.18M - %m%n" />
      </layout>
    </appender>
    <root>
      <level value="ALL" />
      <appender-ref ref="RollingLogFileAppender" />
    </root>
  </log4net>
  <connectionStrings>
    <remove name="InfyBI" />
    <add name="InfyBI" connectionString="server=localhost;Port=5432;database=demo;user id=postgres;password=abc123" providerName="System.Data.PostgrSQLClient" />
  </connectionStrings>
  <appSettings>
    <add key="ServerURL" value="https://sales.quantosaas.com" />
    <add key="Locationcode" value="Chennai" />
    <add key="OrganizationCode" value="" />
    <add key="Data" value="D:\aravindan\project\shopppingkart" />
    <!-- First-run Setup UI sets IsConfigured=true (do not edit manually for normal installs) -->
    <add key="IsConfigured" value="false" />
    <add key="MachineRole" value="" />
    <add key="DeviceId" value="" />
    <add key="MasterDeviceId" value="" />
    <add key="MasterApiUrl" value="" />
    <add key="LastKnownMasterIp" value="" />
    <add key="LastKnownMasterName" value="" />
    <add key="MasterPort" value="" />
    <!-- Bind all interfaces so localhost and LAN clients can reach TCP 8099 -->
    <add key="ListenUrl" value="http://0.0.0.0:8099" />
    <add key="ApiPort" value="8099" />
    <!-- Optional comma-separated CORS origins; empty = allow any (backward compatible) -->
    <add key="AllowedOrigins" value="" />
    <!-- MasterSource: Server = Quanto cloud; Client = pull from MASTER ClientURL / MasterApiUrl -->
    <add key="MasterSource" value="Server" />
    <add key="ClientURL" value="" />
    <add key="BIClientCode" value="B2BQUANTO" />
    <add key="AppMode" value="" />
    <add key="BIDownloadTimer" value="1" />
    <!-- MASTER only: EnableOffline starts cloud master download every OfflineSyncTimer minutes -->
    <add key="EnableOffline" value="true" />
    <add key="OfflineSyncURL" value="https://sales.quantosaas.com" />
    <add key="OfflineSyncTimer" value="15" />
  </appSettings>
</configuration>
